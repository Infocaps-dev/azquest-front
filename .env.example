# Só para rodar a resumos-api na própria máquina (`npm run resumos-api`). Copie para .env.local (ignorado pelo
# git) e preencha com a credencial HMAC do COS. Nunca commite valores reais: este repositório é público.
# Para só mexer na tela não precisa disto: o Vite usa a resumos-api publicada no Code Engine.
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=
PORT=8082
# COS_ENDPOINT=https://s3.br-sao.cloud-object-storage.appdomain.cloud
# COS_BUCKET=ecovias-itr-docs
# AUTH_BFF_URL=https://azquest-auth-bff.2fom3olxz1yh.br-sao.codeengine.appdomain.cloud
